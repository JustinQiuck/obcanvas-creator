{
  "name": "obcanvas-creator",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepare:test-vault": "npm run build && node scripts/prepare-test-vault.mjs",
    "launch:test-vault": "node scripts/launch-test-obsidian.mjs",
    "test:host": "node scripts/test-obsidian.mjs",
    "test:host:reopen": "node scripts/test-obsidian.mjs --reopen",
    "prepare:test-media": "node scripts/prepare-media-fixtures.mjs",
    "test:canvas-media": "node scripts/test-canvas-media.mjs",
    "test:canvas-media:reopen": "node scripts/test-canvas-media.mjs --reopen",
    "stop:test-vault": "node scripts/launch-test-obsidian.mjs --stop",
    "test:selection": "node scripts/test-selection.mjs",
    "test:selection:reopen": "node scripts/test-selection.mjs --reopen",
    "test:free-canvas": "node scripts/test-free-canvas.mjs",
    "test:free-canvas:reopen": "node scripts/test-free-canvas.mjs --reopen",
    "test:assets-ai": "node scripts/test-assets-ai.mjs",
    "test:assets-ai:reopen": "node scripts/test-assets-ai.mjs --reopen",
    "test:deletion": "node scripts/test-deletion.mjs",
    "test:deletion:reopen": "node scripts/test-deletion.mjs --reopen",
    "test:skills": "node scripts/test-skills.mjs",
    "test:skills:reopen": "node scripts/test-skills.mjs --reopen",
    "test:storyboard": "node scripts/test-storyboard.mjs",
    "test:storyboard:reopen": "node scripts/test-storyboard.mjs --reopen",
    "test:projects": "node scripts/test-projects.mjs",
    "test:projects:reopen": "node scripts/test-projects.mjs --reopen",
    "test:storyboard-apply": "node scripts/test-storyboard-apply.mjs",
    "test:storyboard-apply:reopen": "node scripts/test-storyboard-apply.mjs --reopen"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "playwright-core": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
